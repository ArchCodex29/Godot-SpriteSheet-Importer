# Normalize line endings to LF on checkin, leave working copy untouched.
* text=auto eol=lf

# GDScript and Godot text resources
*.gd       text eol=lf
*.cfg      text eol=lf
*.import   text eol=lf
*.tres     text eol=lf
*.tscn     text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf

# Binary assets — never normalize.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ogg      binary
*.wav      binary

# Files not required for the addon to function.
# export-ignore strips them from the asset library download ZIP.
/.editorconfig            export-ignore
/.gitattributes           export-ignore
/.gitignore               export-ignore
/.github/                 export-ignore
/project.godot            export-ignore
/icon.svg                 export-ignore
/icon.svg.import          export-ignore

# Demo / test files (the importer ships under addons/ only)
/testfiles/                export-ignore
/landscapeTiles_sheet.xml  export-ignore
